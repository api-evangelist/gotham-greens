          "name": "Get SEO head metadata for a URL",
          "request": {
            "name": "Get SEO head metadata for a URL",
            "description": {
              "content": "Returns the Yoast-rendered SEO head for a gothamgreens.com URL — meta description, canonical, Open Graph and Twitter card tags, and the schema.org JSON-LD graph.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "yoast",
                "v1",
                "get_head"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) The gothamgreens.com URL to retrieve SEO metadata for."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
