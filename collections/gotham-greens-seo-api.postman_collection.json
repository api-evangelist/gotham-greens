  "info": {
    "_postman_id": "80b2515c-d980-4050-92d2-babf61a22be1",
    "name": "Gotham Greens SEO Metadata API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Yoast SEO REST head endpoint, exposed anonymously on gothamgreens.com. Given any site URL it returns the rendered `<head>` SEO block as HTML plus the structured metadata behind it, including the schema.org JSON-LD graph (Organization, WebSite, WebPage, BreadcrumbList) the site publishes. Verified live on 2026-08-01 (Yoast SEO Premium v28.1). This is a plugin surface, not a Gotham Greens product API.\n\nContact Support:\n Name: Gotham Greens",
      "type": "text/plain"
    }
  }
